# ─── Database (Neon Postgres) ────────────────────────────────────────────────
# Pooled connection — used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Non-pooled connection — used by drizzle-kit (migrations) and DB scripts/tests.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"

# ─── Better Auth ─────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_ROOT_DOMAIN="traballo.pro"

# ─── OAuth (optional — Google sign-in) ───────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=""
# Sender. Must be on a Resend-verified domain. For local testing before
# verifying traballo.pro, use: "Traballo <onboarding@resend.dev>"
EMAIL_FROM="Traballo <noreply@traballo.pro>"

# ─── AI (Anthropic) ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=""

# ─── Maps (Stadia Maps) ──────────────────────────────────────────────────────
# Server key for geocoding artisan addresses. Public tiles use domain auth
# (allow-list traballo.pro + *.traballo.pro in the Stadia dashboard); set
# NEXT_PUBLIC_STADIA_MAPS_API_KEY only if you prefer key-auth for tiles.
STADIA_MAPS_API_KEY=""

# ─── Payments (Stripe) ───────────────────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ─── Admin ───────────────────────────────────────────────────────────────────
# Comma-separated list of emails allowed into admin.traballo.pro
ADMIN_EMAILS=""

# ─── Anti-abuse (public forms) ───────────────────────────────────────────────
# Cloudflare Turnstile protects the marketing contact form and every artisan
# vitrine lead form. Leave unset to disable the check (forms still submit).
#   - Create ONE widget with hostname/domain validation turned OFF so the same
#     key works on *.traballo.pro AND arbitrary artisan custom domains.
#   - The server still verifies each token against Cloudflare.
TURNSTILE_SITE_KEY=""
TURNSTILE_SITE_SECRET=""
# Optional strict hostname allow-list (comma-separated). Applies to the
# marketing form only — the vitrine passes allowAnyHostname. Never localhost.
TURNSTILE_HOSTNAMES="traballo.pro"
# Hard ceiling on lead emails + notifications a single artisan site can
# generate per UTC day. Past this, submissions are dropped silently. Default 30.
SITE_LEAD_DAILY_CAP="30"

# Edge layer (configure in the Vercel dashboard, not here): a Firewall
# rate-limit rule on POST /api/agent* and the sites lead action, plus BotID.
# The in-app rate limiter is best-effort per-instance only.

# ─── Security tests ──────────────────────────────────────────────────────────
# RUN_DB_SECURITY_TESTS=1   # run tests/security/* against DATABASE_URL_UNPOOLED
